# Mẫu biến môi trường của Store Hub. Chép thành .env (hoặc .env.local) rồi điền giá trị. KHÔNG commit file chứa giá trị thật.

# Đường dẫn thư mục Working trên Google Drive (nguồn dữ liệu). Thiếu thì web chạy với dữ liệu rỗng.
WORKING_ROOT=

# Jira (trạng thái task trực tiếp). JIRA_SITE dạng ten-site.atlassian.net
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Zernio: mỗi store một key cố định
ZERNIO_API_KEY_AQUANEST=
ZERNIO_API_KEY_HEARTBOND=
ZERNIO_API_KEY_WHISKERWALL=
